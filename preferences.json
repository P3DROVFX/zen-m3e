[
  {
    "type": "separator",
    "label": "Colour"
  },
  {
    "type": "dropdown",
    "property": "m3e.scheme",
    "label": "Light / dark",
    "defaultValue": "shell",
    "placeholder": false,
    "options": [
      {
        "label": "Follow the shell (matugen mode)",
        "value": "shell"
      },
      {
        "label": "Follow the system",
        "value": "system"
      },
      {
        "label": "Always light",
        "value": "light"
      },
      {
        "label": "Always dark",
        "value": "dark"
      }
    ]
  },
  {
    "type": "string",
    "property": "m3e.colors-path",
    "label": "Matugen palette file (leave empty for the default)",
    "defaultValue": "",
    "placeholder": "(empty: colors.css inside this mod)"
  },
  {
    "type": "separator",
    "label": "Page"
  },
  {
    "type": "dropdown",
    "property": "m3e.page-radius",
    "processAs": "var",
    "value": "string",
    "label": "Page corner radius — keep it at or below your window manager's corner radius minus the gap around the page (Hyprland: decoration:rounding − 8)",
    "defaultValue": "23px",
    "placeholder": false,
    "options": [
      {
        "label": "Square (0)",
        "value": "0px"
      },
      {
        "label": "4 px",
        "value": "4px"
      },
      {
        "label": "8 px",
        "value": "8px"
      },
      {
        "label": "12 px (small)",
        "value": "12px"
      },
      {
        "label": "17 px (normal)",
        "value": "17px"
      },
      {
        "label": "23 px (large, default)",
        "value": "23px"
      },
      {
        "label": "32 px (very large)",
        "value": "32px"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Glass (translucent window)"
  },
  {
    "type": "checkbox",
    "property": "zen.widget.linux.transparency",
    "label": "Give the window an alpha channel on Linux (needed for glass; restart Zen)",
    "restart": true
  },
  {
    "type": "checkbox",
    "property": "m3e.translucent",
    "label": "Translucent browser UI: the compositor blur shows through; pages and video stay opaque"
  },
  {
    "type": "dropdown",
    "property": "m3e.translucent-strength",
    "label": "Glass tint",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      {
        "label": "Light (more see-through)",
        "value": "light"
      },
      {
        "label": "Medium",
        "value": "medium"
      },
      {
        "label": "Strong (more tint)",
        "value": "strong"
      }
    ]
  },
  {
    "type": "checkbox",
    "property": "m3e.translucent-popups",
    "label": "Translucent menus too (turn on decoration:blur:popups in Hyprland first)"
  },
  {
    "type": "checkbox",
    "property": "browser.tabs.allow_transparent_browser",
    "label": "Let web pages be transparent (needed by Zen Internet; restart Zen)"
  },
  {
    "type": "checkbox",
    "property": "zen.view.grey-out-inactive-windows",
    "label": "Grey out the window when it loses focus"
  },
  {
    "type": "separator",
    "label": "Media player"
  },
  {
    "type": "checkbox",
    "property": "m3e.media-expanded",
    "label": "Always show the full media card (otherwise a shorter card without the control rows; full on hover)"
  },
  {
    "type": "separator",
    "label": "Type & motion"
  },
  {
    "type": "checkbox",
    "property": "m3e.system-font",
    "label": "Use the system font instead of Google Sans Flex"
  },
  {
    "type": "checkbox",
    "property": "m3e.reduced-motion",
    "label": "Reduce motion (no springs or staggered entrances)"
  },
  {
    "type": "separator",
    "label": "Essentials & tabs (from SuperPins)"
  },
  {
    "type": "dropdown",
    "property": "m3e.essentials.width",
    "label": "Essentials tile width",
    "defaultValue": "normal",
    "placeholder": false,
    "options": [
      {
        "label": "Thin",
        "value": "thin"
      },
      {
        "label": "Normal",
        "value": "normal"
      },
      {
        "label": "Wide",
        "value": "wide"
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "m3e.essentials.gap",
    "label": "Gap between essentials",
    "defaultValue": "normal",
    "placeholder": false,
    "options": [
      {
        "label": "Small",
        "value": "small"
      },
      {
        "label": "Normal",
        "value": "normal"
      },
      {
        "label": "Big",
        "value": "big"
      }
    ]
  },
  {
    "type": "checkbox",
    "property": "m3e.essentials.no-grow",
    "label": "Keep essentials at a fixed width (don't stretch to fill the row)"
  },
  {
    "type": "checkbox",
    "property": "m3e.essentials.transparent",
    "label": "Transparent essentials until hovered or current"
  },
  {
    "type": "dropdown",
    "property": "m3e.favicon-size",
    "label": "Tab favicon size",
    "defaultValue": "large",
    "placeholder": false,
    "options": [
      {
        "label": "Small (16px)",
        "value": "small"
      },
      {
        "label": "Normal (18px)",
        "value": "normal"
      },
      {
        "label": "Large (20px)",
        "value": "large"
      }
    ]
  },
  {
    "type": "checkbox",
    "property": "m3e.dim-unloaded",
    "label": "Dim unloaded tabs"
  },
  {
    "type": "checkbox",
    "property": "m3e.show-sidebar-scrollbar",
    "label": "Show the sidebar scrollbar"
  }
]
